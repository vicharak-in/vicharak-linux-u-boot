/dts-v1/;
#include "rk3588.dtsi"
#include "rk3588-vaaman2-u-boot.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "Vicharak RK3588 VAAMAN2 VO.3";
	compatible = "vicharak,rk3588-vaaman2", "rockchip,rk3588";

	adc-keys {
		u-boot,dm-pre-reloc;
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		status = "okay";

		back-key {
			u-boot,dm-pre-reloc;
			label = "back";
			linux,code = <KEY_BACK>;
			press-threshold-microvolt = <1235000>;
		};

		menu-key {
			u-boot,dm-pre-reloc;
			label = "menu";
			linux,code = <KEY_MENU>;
			press-threshold-microvolt = <890000>;
		};

		vol-down-key {
			u-boot,dm-pre-reloc;
			label = "volume down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <417000>;
		};

		vol-up-key {
			u-boot,dm-pre-reloc;
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <17000>;
		};
	};

	leds {
		u-boot,dm-pre-reloc;
		compatible = "gpio-leds";
		status = "okay";

		status_led: status-led {
			u-boot,dm-pre-reloc;
			function = "status";
			gpios = <&gpio2 RK_PC5 GPIO_ACTIVE_LOW>;
			default-state = "on";
			linux,default-trigger = "heartbeat";
			retain-state-suspended;
		};
	};

	vbus5v0_typec0: vbus5v0-typec0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vbus5v0_typec0";
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&pca9554 0 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc1_5v0>;
	};

	vbus5v0_typec1: vbus5v0-typec1-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vbus5v0_typec1";
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&pca9554 1 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc1_5v0>;
	};

	vcc0_5v0: vcc5v0_sys: vcc0-5v0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc0_5v0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc20v_dcin>;
	};

	vcc1_5v0: vcc1-5v0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc1_5v0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc20v_dcin>;
	};

	vcc20v_dcin: vcc20v-dcin {
		u-boot,dm-pre-reloc;
		compatible = "regulator-fixed";
		regulator-name = "vcc20v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <20000000>;
		regulator-max-microvolt = <20000000>;
	};

	vcc3v3_io_expander: vcc3v3-io-expander {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_io_expander";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
	};

	vcc3v3_pcie3x4: vcc3v3-pcie3x4 {
		u-boot,dm-pre-reloc;
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie3x4";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;
		//startup-delay-us = <5000>;
		vin-supply = <&vcc20v_dcin>;
	};
};

&gmac1 {
	clock_in_out = "output";
	phy-handle = <&rgmii_phy>;
	phy-mode = "rgmii-rxid";
	// phy-supply = <&vcc_3v3_s3>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_rgmii_bus
		     &gmac1_rgmii_clk
		     &gmac1_rx_bus2
		     &gmac1_tx_bus2
		     &gmac1_miim>;
	rx_delay = <0x00>;
	tx_delay = <0x43>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&i2c4 {
	u-boot,dm-pre-reloc;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m2_xfer>;
	status = "okay";

	pca9554: gpio@24 {
		u-boot,dm-pre-reloc;
		compatible = "nxp,pca9554";
		reg = <0x24>;
		#gpio-cells = <2>;
		gpio-controller;
		gpio-group-num = <300>;
		vcc-supply = <&vcc3v3_io_expander>;
		status = "okay";
	};
};

&mdio1 {
	rgmii_phy: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

&pcie30phy {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&pcie3x4 {
	u-boot,dm-pre-reloc;
	pinctrl-0 = <&pcie3x4_reset>;
	reset-gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie3x4>;
	status = "okay";
};

&pinctrl {
	pcie3x4 {
		pcie3x4_reset: pcie3x4-reset {
			rockchip,pins = <4 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
